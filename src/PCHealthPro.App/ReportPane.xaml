<UserControl x:Class="PCHealthPro.App.ReportPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="12">
  <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" SelectionChanged="SourceChanged"/>
  <TextBox x:Name="Seller" MaxLength="160"/>
  <TextBox x:Name="Price" MaxLength="80"/>
  <TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="3000"/>
  <CheckBox x:Name="HideIds" IsChecked="True" Click="PrivacyChanged"/>
  <StackPanel Orientation="Horizontal" Spacing="8">
   <ComboBox x:Name="Format" SelectedIndex="0"><x:String>PDF</x:String><x:String>JSON</x:String><x:String>HTML</x:String></ComboBox>
   <Button x:Name="ExportButton" Style="{ThemeResource AccentButtonStyle}" Click="Export"/>
   <Button x:Name="HistoryButton" Click="Save"/>
  </StackPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="Summary" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  <Expander x:Name="DetailBox" HorizontalAlignment="Stretch"><TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
  <ComboBox x:Name="CompareBox" HorizontalAlignment="Stretch" SelectionChanged="ComparisonChanged"/>
  <TextBlock x:Name="Comparison" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
 </StackPanel>
</UserControl>
