<UserControl x:Class="PCHealthPro.App.ReadingRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12" Padding="0,4">
   <TextBlock x:Name="Label" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <TextBlock x:Name="Value" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
 </Grid>
</UserControl>
