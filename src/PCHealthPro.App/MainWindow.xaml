<Window x:Class="PCHealthPro.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:PCHealthPro.App">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <NavigationView x:Name="Nav" PaneDisplayMode="Auto" CompactModeThresholdWidth="640"
   ExpandedModeThresholdWidth="1060" OpenPaneLength="264" IsBackButtonVisible="Collapsed"
   IsSettingsVisible="False" SelectionChanged="Navigate">
   <ScrollViewer x:Name="Scroller">
     <StackPanel x:Name="Body" Padding="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
       <TextBlock x:Name="Heading" Style="{ThemeResource TitleTextBlockStyle}"/>
       <InfoBar x:Name="UpdateNotice" IsClosable="True">
         <InfoBar.ActionButton><Button x:Name="ApplyUpdate" Click="InstallUpdate"/></InfoBar.ActionButton>
       </InfoBar>
       <StackPanel x:Name="ManualPane" Spacing="12" Visibility="Collapsed"/>
       <local:ReportPane x:Name="Report" Visibility="Collapsed"/>
       <StackPanel x:Name="OverviewPanel" Spacing="16">
         <StackPanel Orientation="Horizontal" Spacing="12">
           <Button x:Name="QuickCheck" Command="{x:Bind Model.RefreshCommand}" CornerRadius="8" Style="{ThemeResource AccentButtonStyle}"/>
           <ProgressRing x:Name="Progress" Width="24" Height="24"/>
         </StackPanel>
         <TextBlock x:Name="CheckStatus" AutomationProperties.LiveSetting="Polite"/>
         <Button x:Name="NextManual" Visibility="Collapsed" Click="OpenNextManual"/>
         <local:BenchmarkPane x:Name="Benchmark" Visibility="Collapsed"/>
         <InfoBar x:Name="SmartNotice" IsClosable="False" Severity="Informational">
           <InfoBar.ActionButton><Button x:Name="Elevate" Click="RestartElevated"/></InfoBar.ActionButton>
         </InfoBar>
         <Grid x:Name="Cards" ColumnSpacing="12" RowSpacing="12" SizeChanged="ResizeCards"/>
       </StackPanel>
       <StackPanel x:Name="SettingsPanel" Spacing="12" Visibility="Collapsed">
         <ComboBox x:Name="LanguageBox" SelectionChanged="ChangeLanguage" MinWidth="220"/>
         <TextBlock x:Name="Privacy" TextWrapping="Wrap"/>
         <CheckBox x:Name="Updates" Click="ToggleUpdates"/>
         <TextBlock x:Name="UpdateState" TextWrapping="Wrap"/>
       </StackPanel>
       <TeachingTip x:Name="Tip" Target="{x:Bind QuickCheck}" PreferredPlacement="Bottom" Closed="DismissTip"/>
     </StackPanel>
   </ScrollViewer>
 </NavigationView>
</Window>
