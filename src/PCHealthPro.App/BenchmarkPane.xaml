<UserControl x:Class="PCHealthPro.App.BenchmarkPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource InspectionSurface}">
  <StackPanel Spacing="12">
   <StackPanel Orientation="Horizontal" Spacing="12">
    <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <TextBlock x:Name="Title" Style="{ThemeResource SubtitleTextBlockStyle}"/>
   </StackPanel>
   <TextBlock x:Name="MethodInfo" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="Volume" HorizontalAlignment="Stretch" SelectionChanged="VolumeChanged"/>
    <ComboBox x:Name="SizeBox" Grid.Column="1"/>
   </Grid>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <TextBlock x:Name="DirectoryText" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True" Style="{StaticResource MetricLabel}"/>
    <Button Grid.Column="1" x:Name="FolderButton" Click="ChooseFolder"/>
   </Grid>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="StartButton" Click="Start"><StackPanel Orientation="Horizontal" Spacing="8">
     <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     <TextBlock x:Name="StartLabel"/>
    </StackPanel></Button>
    <Button x:Name="CancelButton" Click="Cancel"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="Meter" Minimum="0" Maximum="100"/>
   <TextBlock x:Name="Live" TextWrapping="Wrap"/>
   <TextBlock x:Name="ChartScale" Style="{ThemeResource CaptionTextBlockStyle}"/>
   <Grid x:Name="Plot" Height="72" SizeChanged="PlotResized" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Polyline x:Name="Trace" Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2"/>
   </Grid>
   <TextBlock x:Name="ResultsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  </StackPanel>
 </Border>
</UserControl>
