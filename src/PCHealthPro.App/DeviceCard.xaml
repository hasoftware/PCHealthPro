<UserControl x:Class="PCHealthPro.App.DeviceCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource InspectionSurface}">
  <StackPanel Spacing="12">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
     <Border x:Name="BrandHost" Width="44" Height="44" VerticalAlignment="Top" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
     <FontIcon x:Name="Icon" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </Border>
    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
     <TextBlock x:Name="Title" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <TextBlock x:Name="Subtitle" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="Metrics" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="8" SizeChanged="ResizeMetrics"/>
   <TextBlock x:Name="BenchSummary" TextWrapping="Wrap" Visibility="Collapsed"/>
   <InfoBar x:Name="Health" IsClosable="False" IsOpen="False" Visibility="Collapsed"/>
   <Expander x:Name="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OpenFields"/>
  </StackPanel>
 </Border>
</UserControl>
